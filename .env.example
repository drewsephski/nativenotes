# Neon pooled URL for app runtime (hostname includes `-pooler`).
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Neon direct URL for migrations (no `-pooler`). Prefer this for `pnpm db:migrate`.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# Disposable Neon branch for Vitest DB / OAuth lifecycle tests. Required for `pnpm test`.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@ep-test-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Optional explicit production URL used by the test safety guard.
# PRODUCTION_DATABASE_URL=postgresql://USER:PASSWORD@ep-prod-pooler.REGION.aws.neon.tech/neondb?sslmode=require

BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Canonical PUBLIC origin (no path) — must match what browsers see.
# Local: http://localhost:3000
# Production (after web cutover): https://nativenotes.app
# Never use the private backend Vercel hostname as the production issuer.
BETTER_AUTH_URL=http://localhost:3000

# One canonical MCP resource URL (must be HTTPS off loopback).
# Production: https://nativenotes.app/mcp
MCP_RESOURCE_URL=http://localhost:3000/mcp

# Stable claim namespace (usually https://<domain>/claims).
# Production: https://nativenotes.app/claims
TENANT_CLAIM_NAMESPACE=https://nativenotes.example/claims

# Google OAuth (Better Auth social provider). Required for "Continue with Google".
# Create a Web application OAuth client in Google Cloud Console.
# Authorized redirect URIs (exact):
#   http://localhost:3000/api/auth/callback/google
#   https://nativenotes.app/api/auth/callback/google
# Temporary during rollout (then remove):
#   https://nativenotes.vercel.app/api/auth/callback/google
# Callback path confirmed against better-auth 1.7.6: /api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional comma-separated extra trusted origins (CSRF / redirects).
# Production: TRUSTED_ORIGINS=https://nativenotes.app
# TRUSTED_ORIGINS=https://nativenotes.app

NODE_ENV=development
PORT=3000
